# ─────────────────────────────────────────────
# Stock Drop Monitor — environment variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# SMTP server (defaults work for Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
USE_TLS=true

# Login credentials for your sending e-mail account
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password-here

# From address (defaults to SMTP_USER if left blank)
EMAIL_SENDER=

# One or more recipient addresses, comma-separated
EMAIL_RECIPIENTS=you@example.com,colleague@example.com

# KI-Einordnung der Kursrückgänge (optional) — einer der beiden Keys reicht.
# Groq:   kostenlos, kein Credit Card — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Gemini: kostenlos, kein Credit Card — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ─────────────────────────────────────────────
# Newsticker ("das nächste Nvidia") — optionale Tuning-Parameter
# ─────────────────────────────────────────────
# Mindest-Score (0–100), ab dem eine Aktie in den Newsletter kommt (Default 62)
NEWSTICKER_SCORE_THRESHOLD=62
# Höchstzahl an Kandidaten pro E-Mail (Default 12)
NEWSTICKER_MAX_PICKS=12
# Rollierendes Universum: zusätzlich die große Watchlist (~2.000 Firmen) nach
# Firmen in Wachstumsbranchen durchsuchen (true/false, Default true).
# Nachteil: ein Lauf dauert ~30-60 Min. Für einen schnellen Testlauf auf false.
NEWSTICKER_DISCOVER=true
# Max. Zahl geprüfter Watchlist-Ticker. 0 = komplette Watchlist (Standard,
# rollierend). Zum schnellen Testen z.B. 300 setzen.
NEWSTICKER_DISCOVER_LIMIT=0

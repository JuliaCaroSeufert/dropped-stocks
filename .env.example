# ─────────────────────────────────────────────
# Stock Drop Monitor — environment variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# SMTP server (defaults work for Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
USE_TLS=true

# Login credentials for your sending e-mail account
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password-here

# From address. Bei Resend MUSS dies eine verifizierte Absenderadresse sein
# (verifizierte Domain, oder onboarding@resend.dev für Tests an die eigene Adresse).
# Bei SMTP: leer lassen = SMTP_USER wird verwendet.
EMAIL_SENDER=

# One or more recipient addresses, comma-separated
EMAIL_RECIPIENTS=you@example.com,colleague@example.com

# ── Versandweg: Resend (bevorzugt) ODER SMTP ──────────────────────────────────
# Resend (https://resend.com) — einfachster Weg, nur ein API-Key nötig.
# Ist RESEND_API_KEY gesetzt, läuft der Versand über die Resend-API; SMTP oben
# wird dann ignoriert. EMAIL_SENDER muss eine in Resend verifizierte Adresse sein.
RESEND_API_KEY=re_...

# KI-Einordnung der Kursrückgänge + monatlicher Trend-Report (optional) —
# einer der beiden Keys reicht.
# Groq:   kostenlos, kein Credit Card — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Gemini: kostenlos, kein Credit Card — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ─────────────────────────────────────────────
# Emerging-Trends-Report (monatlich, am 1. des Monats)
# ─────────────────────────────────────────────
# Läuft automatisch im geplanten Modus mit und nutzt dieselben SMTP-Daten oben.
#   Manuell auslösen:   python main.py --trends
#   Nur rendern (Test): python trends.py --research --no-email > report.html
# Für die beste Recherche-Qualität läuft zusätzlich eine monatliche
# Claude-Session (siehe README) — die verschickt über:
#   python trends.py --send <datei.json>
